# syntax=docker/dockerfile:1.7
# Installs a locally built vLLM wheel into a CUDA runtime image.
#
# Build with:
#   ./build-vllm-local-wheel.sh
#   ./build-vllm-local-wheel-docker.sh
#
# The default Ubuntu 26.04 base is intentional: wheels built on newer hosts can
# require newer glibc symbols that Ubuntu 22.04 based images do not provide.
# Override the runtime base only if it has a compatible glibc:
#   BASE_IMAGE=nvidia/cuda:13.3.0-devel-ubuntu26.04 ./build-vllm-local-wheel-docker.sh

ARG BASE_IMAGE=nvidia/cuda:13.3.0-devel-ubuntu26.04
FROM ${BASE_IMAGE}

ARG INSTALL_DEPS=1
ARG CUDA_VERSION=13.0.2
ARG PYTHON_VERSION=3.12
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_CACHE_DIR=/opt/uv/cache

USER root

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libibverbs1 \
        libnuma1 \
        numactl \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages uv \
    && mkdir -p "${UV_PYTHON_INSTALL_DIR}" "${UV_CACHE_DIR}" \
    && uv venv --seed /opt/venv --python "${PYTHON_VERSION}" \
    && ln -sf /opt/venv/bin/python /usr/local/bin/python3

COPY dist/*.whl /tmp/vllm-wheel/

RUN --mount=type=cache,target=/opt/uv/cache \
    set -eux; \
    set -- /tmp/vllm-wheel/*.whl; \
    if [ "$#" -ne 1 ]; then \
        echo "Expected exactly one wheel in /tmp/vllm-wheel, found $#." >&2; \
        exit 1; \
    fi; \
    if [ "${INSTALL_DEPS}" = "1" ]; then \
        uv pip install --python /opt/venv/bin/python --force-reinstall "$1" \
            --extra-index-url "${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo "$CUDA_VERSION" | cut -d. -f1,2 | tr -d '.')"; \
    else \
        uv pip install --python /opt/venv/bin/python --force-reinstall --no-deps "$1"; \
    fi; \
    rm -rf /tmp/vllm-wheel; \
    /opt/venv/bin/python -c "import vllm; print('Installed vLLM', vllm.__version__)"

ENV PATH="/opt/venv/bin:${PATH}"
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV VLLM_TARGET_DEVICE=cuda

ENTRYPOINT ["vllm", "serve"]
